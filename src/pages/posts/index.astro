---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import { SITE_DESCRIPTION } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group by year, newest year first.
const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))];
const byYear = years.map((year) => ({
	year,
	posts: posts.filter((p) => p.data.pubDate.getUTCFullYear() === year),
}));
---

<BaseLayout title="Posts" description={SITE_DESCRIPTION}>
	<div class="wrap">
		<header class="head">
			<h1>Posts</h1>
			<p class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
		</header>
		{posts.length === 0 && <p>No posts yet.</p>}
		{
			byYear.map(({ year, posts }) => (
				<section class="year" aria-labelledby={`y${year}`}>
					<h2 id={`y${year}`} class="year-label">
						{year}
					</h2>
					<PostList posts={posts} />
				</section>
			))
		}
	</div>
</BaseLayout>
<style>
	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-bottom: 1.5rem;
		margin-bottom: 1rem;
		border-bottom: 2px solid var(--ink);
	}
	.head h1 {
		margin: 0;
	}
	.head .meta {
		margin: 0;
	}
	.year {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 0 2rem;
		padding-block: 2rem;
		border-bottom: 1px solid var(--rule);
	}
	.year:last-child {
		border-bottom: 0;
	}
	.year-label {
		margin: 0;
		font-size: 1.9rem;
		font-weight: 400;
		font-style: italic;
		color: var(--accent);
		line-height: 1;
	}
	@media (min-width: 48rem) {
		.year-label {
			position: sticky;
			top: 1.5rem;
			align-self: start;
		}
	}
	@media (max-width: 48rem) {
		.year {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
	}
</style>
