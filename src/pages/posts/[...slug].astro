---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const base = import.meta.env.BASE_URL.replace(/\/$/, '');
	// Oldest first, so each post's neighbours are the posts before and after it in time.
	const posts = (await getCollection('blog')).sort(
		(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
	);
	const link = (post?: CollectionEntry<'blog'>) =>
		post && { title: post.data.title, href: `${base}/posts/${post.id}/` };
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, prev: link(posts[i - 1]), next: link(posts[i + 1]) },
	}));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} prev={prev} next={next}>
	<Content />
</BlogPost>
