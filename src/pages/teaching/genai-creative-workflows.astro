---
import { getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'genai-creative-workflows');

if (!entry) {
	throw new Error('Missing src/content/pages/genai-creative-workflows.md');
}

const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} description={entry.data.description} heroImage={entry.data.heroImage}>
	<Content />
</PageLayout>
