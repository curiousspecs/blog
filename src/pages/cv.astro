---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/BlogPost.astro';

// 1. Fetch the markdown file from your content collection
// (from the 'pages' collection in src/content/pages/, not the blog collection)
const entry = await getEntry('pages', 'cv'); 

// 2. Fail the build if the page source is missing (a redirect to '/404' would skip the /blog base)
if (!entry) {
	throw new Error('Missing src/content/pages/cv.md');
}

// 3. Render the entry to extract the live Content component
// Use the exclamation mark (!) to tell TypeScript: "Trust me, this exists"

const { Content } = await render(entry!);
---

<Layout
	title={entry.data.title}
	description={entry.data.description}
	pubDate={entry.data.pubDate}
	heroImage={entry.data.heroImage}
>
	<!-- 3. The Markdown content will inject itself perfectly right here -->
	<Content />
</Layout>
