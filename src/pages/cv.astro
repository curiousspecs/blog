---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/BlogPost.astro';

// 1. Fetch the markdown file from your content collection
// (Assumes a collection named 'pages' or 'blog' contains your file)
const entry = await getEntry('blog', 'cv'); 

// 2. Add an explicit fallback return or throw to satisfy TypeScript
if (!entry) {
	return Astro.redirect('/404'); 
}

// 3. Render the entry to extract the live Content component
// Use the exclamation mark (!) to tell TypeScript: "Trust me, this exists"

const { Content } = await render(entry!);
---

<Layout
	title={entry.data.title}
	description={entry.data.description}
	pubDate={entry.data.pubDate}
	heroImage={entry.data.heroImage}
>
	<!-- 3. The Markdown content will inject itself perfectly right here -->
	<Content />
</Layout>
