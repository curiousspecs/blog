---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

// From the 'pages' collection in src/content/pages/, not the blog collection.
const entry = await getEntry('pages', 'resume');

// Fail the build if the page source is missing (a redirect to '/404' would skip the /blog base).
if (!entry) {
	throw new Error('Missing src/content/pages/resume.md');
}

const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PageLayout title={entry.data.title} description={entry.data.description} heroImage={entry.data.heroImage}>
	<div class="resume">
		<p class="cv"><a href={`${base}/cv/Bennett_CV.pdf`} download>Download CV (PDF, 3 pp.)</a></p>
		<Content />
	</div>
</PageLayout>
<style>
	.cv {
		font-family: var(--font-ui);
		font-size: 0.95rem;
	}
	/* The section headings are h2 (the page title is the h1); keep them at the size they had as h3. */
	.resume :global(h2) {
		font-size: 1.3em;
	}
</style>
