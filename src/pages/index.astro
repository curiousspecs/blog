---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// The newest post with a hero image leads the page; the next posts follow as a list.
const lead = posts.find((p) => p.data.heroImage) ?? posts[0];
const recent = posts.filter((p) => p !== lead).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="wrap">
		<section class="intro" aria-labelledby="intro-title">
			<h1 id="intro-title">{SITE_TITLE}</h1>
			<!--
				PLACEHOLDER: Matt writes this introduction. Replace this comment with a paragraph
				(a <p> element) introducing the blog. Nothing is shown here until then.
			-->
		</section>

		{
			lead && (
				<section class="lead" aria-labelledby="lead-title">
					<h2 class="ui section-label">Latest</h2>
					<a class="lead-card" href={`${base}/posts/${lead.id}/`}>
						{lead.data.heroImage && (
							<Image
								src={lead.data.heroImage}
								alt=""
								widths={[480, 720, 960]}
								sizes="(min-width: 48rem) 30rem, 100vw"
							/>
						)}
						<div class="lead-text">
							<p class="meta">
								<FormattedDate date={lead.data.pubDate} />
							</p>
							<h3 id="lead-title">{lead.data.title}</h3>
							<p class="desc">{lead.data.description}</p>
						</div>
					</a>
				</section>
			)
		}

		{
			recent.length > 0 && (
				<section class="recent" aria-labelledby="recent-title">
					<h2 id="recent-title" class="ui section-label">
						Recent posts
					</h2>
					<PostList posts={recent} />
					<p class="all">
						<a href={`${base}/posts/`}>All {posts.length} posts →</a>
					</p>
				</section>
			)
		}
	</div>
</BaseLayout>
<style>
	.intro h1 {
		margin: 0 0 1rem;
		font-size: clamp(2.6rem, 1.6rem + 5vw, 5rem);
		font-style: italic;
		font-weight: 400;
	}
	.intro {
		padding-bottom: clamp(1.5rem, 4vw, 3rem);
		margin-bottom: clamp(2rem, 5vw, 3.5rem);
		border-bottom: 2px solid var(--ink);
	}
	.intro :global(p) {
		max-width: var(--measure);
		font-size: 1.2em;
		line-height: 1.5;
	}
	.section-label {
		margin: 0 0 1.25rem;
		color: var(--muted);
		font-weight: 400;
	}
	.lead {
		margin-bottom: clamp(2.5rem, 6vw, 4rem);
	}
	.lead-card {
		display: grid;
		gap: 1.25rem 2.5rem;
		color: var(--ink);
		text-decoration: none;
	}
	@media (min-width: 48rem) {
		.lead-card {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
			align-items: center;
		}
	}
	.lead-card :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		object-position: 50% 25%;
	}
	.lead-text h3 {
		margin: 0.2em 0 0.4em;
		font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
		font-weight: 500;
		line-height: 1.1;
	}
	.lead-card:hover h3 {
		color: var(--accent);
	}
	.lead-text .meta {
		margin: 0;
	}
	.desc {
		margin: 0;
		color: var(--muted);
	}
	.recent {
		max-width: var(--measure);
	}
	.all {
		margin-top: 1.5rem;
		font-family: var(--font-ui);
		font-size: 0.95rem;
	}
</style>
