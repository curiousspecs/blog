---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isArchive } from '../lib/isArchive';
import { postImage } from '../lib/postImage';
import banner2 from '../assets/banner2.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// Older posts are the archive (see src/lib/isArchive.ts); everything else is current.
const current = posts.filter((p) => !isArchive(p.data));
const archive = posts.filter((p) => isArchive(p.data));
// The newest current post leads the page; other current posts follow. No current post, no Latest section.
const lead = current[0];
const recent = current.filter((p) => p !== lead).slice(0, 5);
// From the archive: the essays and publications, not the event notices or link posts.
const fromArchive = archive
	.filter((p) => p !== lead && (p.data.kind === 'essay' || p.data.kind === 'publication'))
	.slice(0, 6);
const archiveYears =
	archive.length > 0
		? `${archive.at(-1)!.data.pubDate.getUTCFullYear()}–${archive[0].data.pubDate.getUTCFullYear()}`
		: '';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="wrap">
		<section class="intro" aria-labelledby="intro-title">
			<div class="intro-main">
				<h1 id="intro-title">{SITE_TITLE}</h1>
				<p class="tagline">{SITE_TAGLINE}</p>
				<div class="intro-text">
					<p>I'm Matt Bennett. I teach film and media production at the University of Cincinnati Blue Ash, and I write about what images do to us and how we make them.</p>
					<p>This blog began in 2014 as a place to read film and television through psychoanalysis: the uncanny, desire, grief, the ghost story. Those posts are still here, and that question hasn't gone away. It has picked up a second one. I'm on research leave this semester, building a course on generative AI in creative work, asking media practitioners in India and at home how AI is changing production, and building AI systems that model Freud's account of the mind. I'm sharing that work here as it happens, including the parts that don't work.</p>
					<p>The name has three meanings. A spectacle is something arresting to look at. Spectacles are the lenses you look through. A spec is the plan for building something. This blog is about all three.</p>
				</div>
			</div>
			<!-- A single decorative banner beside the introduction; it links nowhere. -->
			<Image
				class="banner"
				src={banner2}
				alt=""
				widths={[480, 720, 960, 1440]}
				sizes="(min-width: 62rem) 27rem, (min-width: 56rem) 42vw, 100vw"
				loading="eager"
			/>
		</section>

		{
			lead && (
				<section class="lead" aria-labelledby="lead-title">
					<h2 class="ui section-label">Latest</h2>
					<a
						class:list={['lead-card', { 'has-image': lead.data.heroImage }]}
						href={`${base}/posts/${lead.id}/`}
					>
						{lead.data.heroImage && (
							<Image
								src={lead.data.heroImage}
								alt=""
								widths={[480, 720, 960]}
								sizes="(min-width: 48rem) 30rem, 100vw"
							/>
						)}
						<div class="lead-text">
							<p class="meta">
								<FormattedDate date={lead.data.pubDate} />
							</p>
							<h3 id="lead-title">{lead.data.title}</h3>
							<p class="desc">{lead.data.description}</p>
						</div>
					</a>
				</section>
			)
		}

		{
			recent.length > 0 && (
				<section class="list-section" aria-labelledby="recent-title">
					<h2 id="recent-title" class="ui section-label">
						Recent posts
					</h2>
					<PostList posts={recent} />
				</section>
			)
		}

		{
			fromArchive.length > 0 && (
				<section class="archive-section" aria-labelledby="archive-title">
					<h2 id="archive-title" class="ui section-label">
						From the archive, {archiveYears}
					</h2>
					<ul class="cards">
						{fromArchive.map((post) => {
							const img = postImage(post);
							return (
								<li>
									<a class="card" href={`${base}/posts/${post.id}/`}>
										{img && (
											<Image src={img} alt="" widths={[360, 540, 720]} sizes="(min-width: 62rem) 20rem, (min-width: 40rem) 45vw, 100vw" />
										)}
										<p class="meta">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3>{post.data.title}</h3>
									</a>
								</li>
							);
						})}
					</ul>
					<p class="all">
						<a href={`${base}/posts/`}>All {posts.length} posts →</a>
					</p>
				</section>
			)
		}
	</div>
</BaseLayout>
<style>
	.intro {
		padding-bottom: clamp(1.5rem, 4vw, 3rem);
		margin-bottom: clamp(2rem, 5vw, 3.5rem);
		border-bottom: 2px solid var(--ink);
	}
	@media (min-width: 56rem) {
		.intro {
			display: grid;
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
			gap: 3rem;
			align-items: start;
		}
	}
	.intro :global(.banner) {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 2rem;
		background: var(--surface);
	}
	@media (min-width: 56rem) {
		.intro :global(.banner) {
			margin-top: 0.75rem;
		}
	}
	.archive-section {
		margin-bottom: clamp(2.5rem, 6vw, 4rem);
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 2rem 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card {
		display: block;
		color: var(--ink);
		text-decoration: none;
	}
	.card :global(img) {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		object-position: 50% 25%;
		margin-bottom: 0.75rem;
		background: var(--surface);
	}
	.card .meta {
		margin: 0 0 0.25rem;
	}
	.card h3 {
		margin: 0;
		font-size: 1.2rem;
		line-height: 1.25;
	}
	.card:hover h3 {
		color: var(--accent);
	}
	.intro h1 {
		margin: 0 0 0.25rem;
		font-size: clamp(2.6rem, 1.6rem + 5vw, 5rem);
		font-style: italic;
		font-weight: 400;
	}
	.tagline {
		margin: 0 0 1.75rem;
		font-family: var(--font-ui);
		font-size: 0.95rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.intro-text {
		max-width: var(--measure);
	}
	.intro-text p:first-child {
		font-size: 1.2em;
		line-height: 1.5;
	}
	.intro-text p:last-child {
		margin-bottom: 0;
	}
	.section-label {
		margin: 0 0 1.25rem;
		color: var(--muted);
		font-weight: 400;
	}
	.lead {
		margin-bottom: clamp(2.5rem, 6vw, 4rem);
	}
	.lead-card {
		display: grid;
		gap: 1.25rem 2.5rem;
		max-width: var(--measure);
		color: var(--ink);
		text-decoration: none;
	}
	@media (min-width: 48rem) {
		.lead-card.has-image {
			max-width: none;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
			align-items: center;
		}
	}
	.lead-card :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		object-position: 50% 25%;
	}
	.lead-text h3 {
		margin: 0.2em 0 0.4em;
		font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
		font-weight: 500;
		line-height: 1.1;
	}
	.lead-card:hover h3 {
		color: var(--accent);
	}
	.lead-text .meta {
		margin: 0;
	}
	.desc {
		margin: 0;
		color: var(--muted);
	}
	.list-section {
		max-width: var(--measure);
		margin-bottom: clamp(2.5rem, 6vw, 4rem);
	}
	.all {
		margin-top: 1.5rem;
		font-family: var(--font-ui);
		font-size: 0.95rem;
	}
</style>
