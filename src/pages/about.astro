---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

// From the 'pages' collection in src/content/pages/, not the blog collection.
const entry = await getEntry('pages', 'about');

// Fail the build if the page source is missing (a redirect to '/404' would skip the /blog base).
if (!entry) {
	throw new Error('Missing src/content/pages/about.md');
}

const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} description={entry.data.description} heroImage={entry.data.heroImage}>
	<Content />
</PageLayout>
