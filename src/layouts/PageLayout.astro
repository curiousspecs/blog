---
// Layout for standalone pages (About, CV): title, optional hero image and body; no date.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	heroImage?: ImageMetadata;
}

const { title, description, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article>
		<header class="measure page-head">
			<h1>{title}</h1>
		</header>
		{
			heroImage && (
				<figure class="hero">
					<Image src={heroImage} alt="" widths={[640, 960, 1280, 1600]} sizes="(min-width: 62rem) 62rem, 100vw" />
				</figure>
			)
		}
		<div class="measure prose">
			<slot />
		</div>
	</article>
</BaseLayout>
<style>
	.page-head h1 {
		margin: 0 0 2.5rem;
	}
	.hero {
		width: min(100%, var(--wide));
		margin: 0 auto 3rem;
	}
	.hero :global(img) {
		width: 100%;
		max-height: 60vh;
		object-fit: cover;
	}
</style>
