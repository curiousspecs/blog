---
// Layout for standalone pages (About, Résumé): the shared page header, optional banner and body; no date.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	heroImage?: ImageMetadata;
}

const { title, description, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article class="wrap">
		<header class="page-head">
			<h1>{title}</h1>
		</header>
		{
			heroImage && (
				<figure class="hero">
					<Image src={heroImage} alt="" widths={[640, 960, 1280, 1600]} sizes="(min-width: 62rem) 62rem, 100vw" />
				</figure>
			)
		}
		<div class="prose body">
			<slot />
		</div>
	</article>
</BaseLayout>
<style>
	/*
		The banner sits under the header rule with the same gap as between the title's baseline and the rule.
		That gap is the header padding plus the part of the title's line box below its baseline, which for
		Newsreader at line-height 1.05 measures 0.2626 × font size + 1.85px (within 0.1px from 34px to 54px).
		The header's 1rem bottom margin collapses into this larger margin, so it is not added.
	*/
	.hero {
		margin: calc(var(--page-head-pad) + 0.2626 * var(--h1-size) + 1.85px) 0 3rem;
	}
	.hero :global(img) {
		width: 100%;
		max-height: 60vh;
		object-fit: cover;
	}
	.body {
		max-width: var(--measure);
		margin-top: 2.5rem;
	}
	.hero + .body {
		margin-top: 0;
	}
</style>
