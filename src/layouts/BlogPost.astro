---
// Layout for a single post: title block, optional hero image, body, provenance note and
// previous/next navigation.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

type Neighbour = { title: string; href: string } | undefined;
type Props = CollectionEntry<'blog'>['data'] & { prev?: Neighbour; next?: Neighbour };

const { title, description, pubDate, updatedDate, heroImage, wordpressUrl, prev, next } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article>
		<header class="measure post-head">
			<p class="meta">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span>
							{' '}
							· Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			<h1>{title}</h1>
		</header>
		{
			heroImage && (
				<figure class="hero">
					<Image src={heroImage} alt="" widths={[640, 960, 1280, 1600]} sizes="(min-width: 62rem) 62rem, 100vw" />
				</figure>
			)
		}
		<div class="measure prose">
			<slot />
		</div>
		{
			wordpressUrl && (
				<p class="measure meta provenance">
					Originally published at <a href={wordpressUrl}>mattbennettucba.wordpress.com</a>.
				</p>
			)
		}
		{
			(prev || next) && (
				<nav class="measure pager" aria-label="More posts">
					{prev && (
						<a class="older" href={prev.href} rel="prev">
							<span class="ui">Older</span>
							<span class="t">{prev.title}</span>
						</a>
					)}
					{next && (
						<a class="newer" href={next.href} rel="next">
							<span class="ui">Newer</span>
							<span class="t">{next.title}</span>
						</a>
					)}
				</nav>
			)
		}
	</article>
</BaseLayout>
<style>
	.post-head {
		margin-bottom: 2.5rem;
	}
	.post-head h1 {
		margin: 0.35em 0 0;
	}
	.post-head .meta {
		margin: 0;
	}
	.hero {
		width: min(100%, var(--wide));
		margin: 0 auto 3rem;
	}
	.hero :global(img) {
		width: 100%;
		max-height: 75vh;
		object-fit: cover;
	}
	.provenance {
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-top: 2.5rem;
	}
	.pager a {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		color: var(--ink);
		text-decoration: none;
	}
	.pager a:hover .t {
		color: var(--accent);
	}
	.pager .ui {
		color: var(--muted);
	}
	.pager .t {
		font-size: 1.05rem;
		line-height: 1.3;
	}
	.newer {
		grid-column: 2;
		text-align: right;
	}
	@media (max-width: 36rem) {
		.pager {
			grid-template-columns: 1fr;
		}
		.newer {
			grid-column: 1;
			text-align: left;
		}
	}
</style>
