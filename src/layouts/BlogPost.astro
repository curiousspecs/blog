---
// Layout for a single post: title block, series links, optional hero image, body and
// previous/next navigation.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';
import { isArchive } from '../lib/isArchive';

type Neighbour = { title: string; href: string } | undefined;
type SeriesNav = { name: string; part: number; total: number; prev: Neighbour; next: Neighbour };
type Props = CollectionEntry<'blog'>['data'] & {
	prev?: Neighbour;
	next?: Neighbour;
	seriesNav?: SeriesNav;
	// The image for social cards: the hero, or else the first image in the post.
	socialImage?: ImageMetadata;
};

const { title, description, pubDate, updatedDate, heroImage, prev, next, seriesNav, socialImage } = Astro.props;
---

<BaseLayout title={title} description={description} image={socialImage ?? heroImage}>
	<article>
		<header class="measure post-head">
			<p class="meta">
				{isArchive(Astro.props) && <span class="ui archive-label">Archive</span>}
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span>
							{' '}
							· Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			<h1>{title}</h1>
		</header>
		{
			seriesNav && (
				<nav class="measure series" aria-label={`${seriesNav.name} series`}>
					<p class="ui">
						{seriesNav.name}, part {seriesNav.part} of {seriesNav.total}
					</p>
					{(seriesNav.prev || seriesNav.next) && (
						<ul>
							{seriesNav.prev && (
								<li>
									<span class="ui">Previous</span> <a href={seriesNav.prev.href}>{seriesNav.prev.title}</a>
								</li>
							)}
							{seriesNav.next && (
								<li>
									<span class="ui">Next</span> <a href={seriesNav.next.href}>{seriesNav.next.title}</a>
								</li>
							)}
						</ul>
					)}
				</nav>
			)
		}
		{
			heroImage && (
				<figure class="hero">
					<Image
						src={heroImage}
						alt=""
						widths={[640, 960, 1280, 1600]}
						sizes="(min-width: 62rem) 62rem, 100vw"
						loading="eager"
						fetchpriority="high"
					/>
				</figure>
			)
		}
		<div class="measure prose">
			<slot />
		</div>
		{
			(prev || next) && (
				<nav class="measure pager" aria-label="More posts">
					{prev && (
						<a class="older" href={prev.href} rel="prev">
							<span class="ui">Older</span>
							<span class="t">{prev.title}</span>
						</a>
					)}
					{next && (
						<a class="newer" href={next.href} rel="next">
							<span class="ui">Newer</span>
							<span class="t">{next.title}</span>
						</a>
					)}
				</nav>
			)
		}
	</article>
</BaseLayout>
<style>
	.post-head {
		margin-bottom: 2.5rem;
	}
	.post-head h1 {
		margin: 0.35em 0 0;
	}
	.post-head .meta {
		margin: 0;
	}
	.archive-label {
		margin-right: 0.6rem;
		padding-right: 0.6rem;
		border-right: 1px solid var(--rule);
		color: var(--accent);
		font-size: 0.75rem;
	}
	.series {
		margin-bottom: 2.5rem;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--rule);
		font-size: 1rem;
		line-height: 1.4;
	}
	.series p {
		margin: 0;
		color: var(--muted);
	}
	.series ul {
		display: grid;
		gap: 0.35rem;
		margin: 0.6rem 0 0;
		padding: 0;
		list-style: none;
	}
	.series li {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		align-items: baseline;
	}
	.series li .ui {
		color: var(--muted);
	}
	.hero {
		width: min(100%, var(--wide));
		margin: 0 auto 3rem;
	}
	.hero :global(img) {
		width: 100%;
		max-height: 75vh;
		object-fit: cover;
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-top: 2.5rem;
	}
	.pager a {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		color: var(--ink);
		text-decoration: none;
	}
	.pager a:hover .t {
		color: var(--accent);
	}
	.pager .ui {
		color: var(--muted);
	}
	.pager .t {
		font-size: 1.05rem;
		line-height: 1.3;
	}
	.newer {
		grid-column: 2;
		text-align: right;
	}
	@media (max-width: 36rem) {
		.pager {
			grid-template-columns: 1fr;
		}
		.newer {
			grid-column: 1;
			text-align: left;
		}
	}
</style>
