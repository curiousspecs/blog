---
import { PROFILES } from '../consts';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
	<div class="wrap inner meta">
		<p class="copy">&copy; {year} Matt Bennett. All rights reserved.</p>
		<ul class="links">
			<li>
				<a href={`${base}/rss.xml`}>
					<svg class="rss" viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
						><path
							fill="currentColor"
							d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm1.5 2.5c5.523 0 10 4.477 10 10a1 1 0 1 1-2 0 8 8 0 0 0-8-8 1 1 0 0 1 0-2m0 4a6 6 0 0 1 6 6 1 1 0 1 1-2 0 4 4 0 0 0-4-4 1 1 0 0 1 0-2m.5 7a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3"
						></path></svg
					>
					<span class="word">RSS</span>
				</a>
			</li>
			<li>
				<a href="https://linkedin.com/in/filmteacher" rel="me">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
						><path
							fill="currentColor"
							d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
						></path></svg
					>
					<span class="word">LinkedIn</span>
				</a>
			</li>
			<li>
				<a href="https://github.com/curiousspecs" rel="me">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
					<span class="word">GitHub</span>
				</a>
			</li>
			<li>
				<a href={PROFILES.orcid} rel="me">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"
						><path
							fill="currentColor"
							d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z"
						></path></svg
					>
					<span class="word">ORCID</span>
				</a>
			</li>
			<li>
				<a href={PROFILES.academia} rel="me">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"
						><path
							fill="currentColor"
							d="M22.033 21.18L13.77.459H7.869l1.049 2.623L1.836 21.18C1.574 22.098.787 22.23 0 22.361v1.18h6.82v-1.18C4.984 22.23 3.934 21.967 4.721 20c.131-.131.656-1.574 1.311-3.41h8.393l1.18 3.016c.131.525.262.918.262 1.311 0 1.049-.918 1.443-2.623 1.443v1.18H24v-1.18c-.918-.13-1.705-.393-1.967-1.18zM6.82 14.361a363.303 363.303 0 0 0 3.279-8.525l3.41 8.525H6.82z"
						></path></svg
					>
					<span class="word">Academia.edu</span>
				</a>
			</li>
		</ul>
	</div>
	<!-- Phones: the copyright line sits below the pinned bar, in the page, not pinned. -->
	<p class="wrap colophon meta">&copy; {year} Matt Bennett. All rights reserved.</p>
</footer>
<style>
	/* Sticky: pinned to the bottom of the window while the page scrolls under it, and back in its
	   place at the end of the page. One row, about 44px tall; html's scroll-padding-bottom
	   (global.css) keeps focused elements clear of it. */
	.site-footer {
		--colophon-height: 0px;
		position: sticky;
		/* A negative offset leaves the colophon (phones only) below the window while the bar is pinned. */
		bottom: calc(-1 * var(--colophon-height));
		z-index: 5;
		margin-top: 2rem;
		background: var(--paper);
		border-top: 1px solid var(--rule);
	}
	.inner {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.55rem calc(0.55rem + env(safe-area-inset-bottom, 0px));
		line-height: 1.4;
		white-space: nowrap;
	}
	p {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	/* Desktop: RSS is a word only, and the copyright line is in the bar. */
	.rss,
	.colophon {
		display: none;
	}
	/* Phones and narrow windows: the bar holds only the five service icons, each named by its visually
	   hidden word; the copyright line moves to the colophon below it. The full desktop row (copyright,
	   RSS, LinkedIn, GitHub, ORCID, Academia.edu) needs about 706px of content, so with the page gutters
	   and a possible scrollbar this applies up to 50rem (800px). */
	@media (max-width: 50rem) {
		.site-footer {
			--colophon-height: 2.75rem;
		}
		.inner {
			justify-content: center;
			padding-block: 0.25rem calc(0.25rem + env(safe-area-inset-bottom, 0px));
		}
		.copy {
			display: none;
		}
		.links {
			gap: 1.5rem;
		}
		a {
			padding: 0.5rem;
		}
		.rss {
			display: block;
		}
		.word {
			position: absolute;
			width: 1px;
			height: 1px;
			margin: -1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
		.colophon {
			display: flex;
			align-items: center;
			height: var(--colophon-height);
			margin-inline: auto;
		}
	}
	@media print {
		.site-footer {
			position: static;
		}
	}
</style>
