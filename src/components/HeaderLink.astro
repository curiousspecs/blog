---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

// Prefix root-relative links with the site's base path ('/blog').
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localizedHref = typeof href === 'string' && href.startsWith('/') ? `${base}${href}` : href;

// Active when this is the current page, or (for section links) an ancestor of it.
const strip = (path: string) => path.replace(/\/$/, '');
const current = strip(Astro.url.pathname);
const target = strip(String(localizedHref));
const isHome = target === base;
const isActive = current === target || (!isHome && current.startsWith(`${target}/`));
---

<a
	href={localizedHref}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		padding: 0.35rem 0;
		color: var(--muted);
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}
	a:hover {
		color: var(--ink);
	}
	a.active {
		color: var(--ink);
		border-bottom-color: var(--accent);
	}
</style>
