---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

// Site home, including the /blog base.
const homeHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<header class="site-header">
	<div class="wrap bar">
		<a class="brand" href={homeHref}>
			<svg class="mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
				<g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
					<circle cx="18" cy="36" r="12"></circle>
					<circle cx="46" cy="36" r="12"></circle>
					<path d="M30 34 q2 -4 4 0"></path>
					<path d="M6 34 L3 22 M58 34 L61 22"></path>
				</g>
			</svg>
			<span class="name">{SITE_TITLE}</span>
		</a>
		<nav aria-label="Main">
			<ul class="ui">
				<li><HeaderLink href="/">Home</HeaderLink></li>
				<li><HeaderLink href="/posts">Posts</HeaderLink></li>
				<li><HeaderLink href="/publications">Publications</HeaderLink></li>
				<li><HeaderLink href="/about">About</HeaderLink></li>
				<li><HeaderLink href="/resume">Résumé</HeaderLink></li>
			</ul>
		</nav>
	</div>
</header>
<style>
	.site-header {
		border-bottom: 1px solid var(--rule);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 1rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--ink);
		text-decoration: none;
	}
	.mark {
		width: 2.1rem;
		height: 2.1rem;
		color: var(--accent);
		flex: none;
	}
	.name {
		font-family: var(--font-read);
		font-size: 1.45rem;
		font-style: italic;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1;
	}
	.brand:hover .name {
		color: var(--accent);
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 26rem) {
		ul {
			gap: 0.25rem 1rem;
		}
	}
</style>
