---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The 404 page is served at every missing URL, so it has no canonical address.
const isNotFound = /\/404\/?$/.test(Astro.url.pathname);

const { title, description, image } = Astro.props;

// BASE_URL is the site's base path ('/blog'); files under public/ and generated feeds live beneath it.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Social-card image: a 1200px-wide JPEG of the page's hero image, when it has one.
const socialImage = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;
const socialImageURL = socialImage ? new URL(socialImage.src, Astro.site) : undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(`${base}/rss.xml`, Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)" />

<Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
<Font cssVariable="--font-atkinson" />

<!-- Canonical URL -->
{isNotFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

<!-- Primary Meta Tags -->
<title>{title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
{!isNotFound && <meta property="og:url" content={canonicalURL} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{socialImageURL && <meta property="og:image" content={socialImageURL} />}

<!-- Twitter -->
<meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
